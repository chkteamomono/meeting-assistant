@echo off
chcp 65001 > nul
cd /d "%~dp0..\..\.."

echo ============================================
echo  다른 사람에게 전달할 소스코드.zip 만들기
echo ============================================
echo.
echo git에 커밋된 내용만 담습니다(회의·면접 데이터 폴더는 애초에 git에 없어서
echo 이 압축에도 절대 포함되지 않습니다) — 아직 커밋 안 한 변경사항이 있다면
echo 먼저 커밋부터 하세요.
echo.

git archive --format=zip -o "소스코드\00. 시작하기\배포용\소스코드.zip" HEAD -- 소스코드 실행하기.bat 실행하기.ico README.md
if errorlevel 1 (
    echo.
    echo [ERROR] 압축 실패.
    pause
    exit /b 1
)

echo.
echo ============================================
echo  완료: 소스코드\00. 시작하기\배포용\소스코드.zip
echo  이 파일을 같은 폴더의 설치.bat, 압축풀기.py와 함께 전달하세요
echo  (3개 파일을 한 폴더에 모아 압축해서 보내면 편합니다).
echo ============================================
echo.
pause
